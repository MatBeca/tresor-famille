rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Le créateur de Pépite peut lire (jamais modifier) toutes les familles, pour le tableau de bord d'usage.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "matthieu.becamel@gmail.com";
    }
    // Chaque famille ne voit et ne modifie que ses propres données.
    match /familles/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
      match /enfants/{enfant} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      // Téléphones des parents abonnés aux notifications.
      match /push/{appareil} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Lecture groupée de tous les enfants, pour le tableau de bord.
    match /{chemin=**}/enfants/{enfant} {
      allow read: if isAdmin();
    }
    // Avis envoyés depuis l'appli : chaque famille peut en déposer, seul le créateur les lit.
    match /avis/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow read, delete: if isAdmin();
    }
    // File des notifications : chaque famille dépose ses événements, la tâche planifiée les envoie puis les efface.
    match /push_queue/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['cadeau', 'palier', 'objectif', 'serie', 'bourse', 'test'];
    }
    // Clé publique des notifications : lisible par les familles connectées, écrite par le créateur.
    match /config/push {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // Clé privée des notifications : seulement le créateur (et la tâche planifiée, via la clé de service).
    match /config/pushPrivate {
      allow read, write: if isAdmin();
    }
    // Anciennes données de la première version, lues une fois pour l'import.
    match /tresor/{doc} {
      allow read: if isAdmin();
    }
  }
}
