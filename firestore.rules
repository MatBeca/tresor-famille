rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque famille ne voit et ne modifie que ses propres données.
    match /familles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /enfants/{enfant} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Anciennes données de la première version, lues une fois pour l'import.
    match /tresor/{doc} {
      allow read: if request.auth != null && request.auth.token.email == "matthieu.becamel@gmail.com";
    }
  }
}
